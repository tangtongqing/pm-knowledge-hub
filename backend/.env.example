# ==============================================================================
# PM Knowledge Hub — Backend Configuration Template
# ==============================================================================
# 复制此文件为 .env，并根据您的本地开发环境填写具体参数：
# 复制命令: cp .env.example .env
# ==============================================================================

# 1. 本地 Obsidian 知识库绝对路径（支持 Windows 正斜杠 "/" 分隔符）
# 例如: NOTES_DIR="C:/Users/username/Documents/ObsidianVault"
NOTES_DIR="C:/Users/tangtongqing/Desktop/学习/从零开始成为产品经理/从零开始成为ai产品经理"

# 2. Chroma 向量数据库数据存储目录
CHROMA_DB_PATH="./data/chroma_db"

# 3. 文本 Embedding 模型名称 (ChromaDB 向量化及语义检索使用)
# 默认使用支持中英双语、高性能轻量模型。首次运行会自动下载缓存（约 120MB），后续全离线运行。
EMBEDDING_MODEL="paraphrase-multilingual-MiniLM-L12-v2"

# 4. 大模型供应商
# auto: 优先硅基流动，其次 Gemini；均无密钥时使用本地 Mock。
# 也可显式设置为 siliconflow 或 gemini。
AI_PROVIDER="auto"

# 4.1 硅基流动（OpenAI 兼容接口）
SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_MODEL="THUDM/GLM-4-9B-0414"
SILICONFLOW_QA_MODEL="Qwen/Qwen3-30B-A3B-Instruct-2507"
SILICONFLOW_INTERVIEW_MODEL="Qwen/Qwen3-30B-A3B-Instruct-2507"
SILICONFLOW_TIMEOUT_SECONDS="90"

# 4.2 Google Gemini（备用）
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 用于 RAG 智能对话及模拟面试 STAR 深度评估打分。
# 【隐私与安全提示】：
#   - 配置有效密钥后，系统在您发起对话时，会将检索到的部分笔记片段（非全文）
#     外发至所选供应商（硅基流动或 Google）。
#   - 若希望 100% 本地运行且杜绝数据外发，请保持两个密钥均为空。
#     系统将安全降级为本地 Mock 模式（离线静态预设回答）。

# 5. HuggingFace 镜像配置（若网络下载 Embedding 缓慢可开启，默认留空即可）
# HF_ENDPOINT="https://hf-mirror.com"
